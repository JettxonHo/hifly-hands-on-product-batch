# Tencent Cloud 2C4G internal pilot. Replace every placeholder before start.

HTTP_PORT=80
HTTPS_PORT=443
PUBLIC_HOST=pilot.example.invalid
PUBLIC_ORIGIN=https://pilot.example.invalid
TLS_CERT_DIR=./deploy/certs

POSTGRES_DB=hifly_pilot
POSTGRES_USER=hifly_pilot
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://hifly_pilot:replace-with-a-long-random-password@postgres:5432/hifly_pilot
DATABASE_POOL_MAX=8
DATABASE_SSL=false

INITIAL_ADMIN_ENABLED=true
INITIAL_ADMIN_EMAIL=admin@pilot.example.invalid
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-initial-password
INITIAL_ADMIN_DISPLAY_NAME=Pilot Admin
INITIAL_ORGANIZATION_ID=org_pilot
INITIAL_ORGANIZATION_NAME=Pilot Organization

PRODUCTION_EXECUTOR=fail_closed
COPY_GENERATION_PROVIDER=phase1_controlled_test_double
COPY_QUALITY_EVALUATOR=phase1_controlled_test_double
COPY_QUALITY_REWRITER=phase1_controlled_test_double
DEEPSEEK_API_KEY=
HIFLY_API_TOKEN=
HIFLY_API_TIMEOUT_MS=10000
LOCAL_AGENT_ENABLED=false
LOCAL_AGENT_ID=
LOCAL_AGENT_ORGANIZATION_ID=
LOCAL_AGENT_TOKEN=
LOCAL_AGENT_LEASE_MS=30000
CLOUD_EXECUTOR_ENABLED=false
CLOUD_EXECUTOR_MODE=fail_closed
CLOUD_EXECUTOR_ID=
CLOUD_EXECUTOR_ORGANIZATION_ID=
CLOUD_EXECUTOR_HEARTBEAT_TOKEN=
CLOUD_EXECUTOR_HEARTBEAT_TIMEOUT_MS=15000
CLOUD_EXECUTOR_HEARTBEAT_URL=
CLOUD_EXECUTOR_CONCURRENCY=1
CLOUD_EXECUTOR_DATABASE_POOL_MAX=3
CLOUD_EXECUTOR_HANDOFF_DIR=/var/lib/hifly/manual-handoff-packages
CLOUD_EXECUTOR_POLL_INTERVAL_MS=1000
CLOUD_EXECUTOR_LEASE_MS=30000
CLOUD_EXECUTOR_HEARTBEAT_INTERVAL_MS=5000
CLOUD_EXECUTOR_ROOT=/var/lib/hifly-executor
CLOUD_EXECUTOR_PROFILE_DIR=/var/lib/hifly-executor/profile
CLOUD_EXECUTOR_ASSETS_DIR=/var/lib/hifly-executor/assets
CLOUD_EXECUTOR_OUTPUTS_DIR=/var/lib/hifly-executor/outputs
CLOUD_EXECUTOR_EVIDENCE_DIR=/var/lib/hifly-executor/evidence
CLOUD_EXECUTOR_MIN_FREE_BYTES=1073741824
CLOUD_EXECUTOR_HIFLY_CONFIG_PATH=
CLOUD_EXECUTOR_AVATAR_MAPPING_FILE=
CLOUD_EXECUTOR_DISPLAY=:99
CLOUD_EXECUTOR_HEALTH_HOST=127.0.0.1
CLOUD_EXECUTOR_HEALTH_PORT=3001
CLOUD_EXECUTOR_NOVNC_BIND_HOST=127.0.0.1
CLOUD_EXECUTOR_NOVNC_PORT=6080
CLOUD_EXECUTOR_NOVNC_HOST_PORT=6080
TRUSTED_HOSTS=127.0.0.1,localhost,127.0.0.1:3000,localhost:3000,app:3000
TRUSTED_ORIGINS=
BACKUP_DIR=/var/backups/hifly
